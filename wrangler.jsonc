{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dssolution",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dssolution"
    }
  ]
}
