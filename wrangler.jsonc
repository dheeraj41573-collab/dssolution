{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dssolution",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dssolution"
    }
  ]
}
