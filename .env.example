# GoHighLevel API credentials
# Get your Private Integration API Key from:
# GHL → Settings → Integrations → Private Integration
GHL_API_KEY=

# Your GHL Location (sub-account) ID
# Found in GHL → Settings → Business Info → Location ID
GHL_LOCATION_ID=

# Contact form: send submissions to the admin inbox through Resend
# Create an API key and verify your sending domain in Resend
RESEND_API_KEY=
CONTACT_NOTIFICATION_FROM=
CONTACT_NOTIFICATION_EMAIL=info@thedssolution.com

# Shared CMS API base URL (also used by the admin app)
NEXT_PUBLIC_CMS_API_URL=https://digital-solution-1-h8nk.onrender.com/api
# Server-only shared secrets; use the same values as the CMS API environment.
SEO_REVALIDATE_SECRET=replace-with-a-long-random-shared-secret
SEO_RENDERER_SECRET=replace-with-a-different-long-random-secret

# Stripe Settings
# Find your Secret key in the Stripe Dashboard (sk_test_...)
STRIPE_SECRET_KEY=

# Stripe Webhook Secret (whsec_...)
# Generated when you create an endpoint in Developers -> Webhooks or run `stripe listen` locally
STRIPE_WEBHOOK_SECRET=

# AI chat widget (get a key at https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional, default is claude-haiku-5-5
# CHAT_MODEL=claude-haiku-5-5

# Instagram carousel: long-lived Instagram user access token for an Instagram
# professional account with instagram_business_basic permission (Instagram Login).
# Do not use a Facebook Graph API token here.
INSTAGRAM_ACCESS_TOKEN=
# Optional: how many latest posts to show (default 30)
# INSTAGRAM_MAX_POSTS=30
